PORT=3000
JWT_SECRET=replace_this_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=24h
NODE_ENV=development

# E-Mail — Bestellbestätigungen via Gmail (oder beliebiger SMTP, s.u.)
# 1. Geh zu myaccount.google.com/apppasswords
# 2. Erstelle ein App-Passwort (Name z.B. "Online Shop")
# 3. Das 16-stellige Passwort hier eintragen (Leerzeichen weglassen)
GMAIL_USER=deine@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Optional: anderer SMTP-Server (z.B. Resend/Postmark/SES) statt Gmail
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# Branded Absender (Zustellbarkeit!). Domain muss von SPF/DKIM gedeckt sein.
# MAIL_FROM=Norevan <hello@norevan.shop>

# Fehler-Monitoring (optional). Ohne SENTRY_DSN komplett inaktiv.
# SENTRY_DSN=https://xxxxx@oXXX.ingest.sentry.io/XXX
# SENTRY_TRACES_SAMPLE_RATE=0

CORS_ORIGINS=http://localhost:3000

# Shared secret for scheduled-task endpoints (e.g. abandoned-cart reminders).
# Must match the CRON_SECRET repo secret used by .github/workflows. When unset,
# the task endpoints are disabled (fail closed).
CRON_SECRET=replace_with_a_long_random_secret

# Seller details printed on the PDF invoice (§14 UStG). Defaults are placeholders.
INVOICE_SELLER_NAME=Norevan UG (haftungsbeschränkt)
INVOICE_SELLER_ADDRESS=Musterstraße 1, 10115 Berlin
INVOICE_SELLER_EMAIL=hello@norevan.shop
INVOICE_SELLER_VAT_ID=DE000000000
