# Claude API key for the AI website helper (console.anthropic.com → API Keys).
# Add billing/credit on the Anthropic account or calls fail with 401.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default claude-opus-4-8).
AI_MODEL=claude-opus-4-8

# Used by the logout redirect in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
